{
  "manifest_version": 3,
  "name": "SFDC Build Tool",
  "version": "0.1.0",
  "description": "Describe Salesforce changes in plain language, review them, and deploy to the org you are logged into. Uses your existing Salesforce browser session.",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open SFDC Build Tool",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "panel/index.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": ["cookies", "storage", "sidePanel"],
  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.force.com/*",
    "https://*.salesforce-setup.com/*",
    "https://salesforce-debugtool.herokuapp.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'; connect-src 'self' https://*.salesforce.com https://*.force.com https://*.salesforce-setup.com https://salesforce-debugtool.herokuapp.com"
  }
}
